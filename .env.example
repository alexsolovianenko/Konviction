# All settings are server-side. Public market data needs none of these.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
SQLITE_PATH=data/capture.sqlite

# Optional Gemini Sandbox account and trusted telephony backend
GEMINI_API_KEY=
GEMINI_API_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOOL_SHARED_SECRET=
PUBLIC_PHONE_NUMBER=
# Four private decimal digits for local portfolio access and separate browser approval.
DEMO_PIN=
EXECUTION_ENABLED=false

# Optional Solana devnet receipt signer (JSON keypair) and RPC
SOLANA_RECEIPT_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
