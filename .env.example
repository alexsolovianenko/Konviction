# All settings are server-side. Public market data needs none of these.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional branchId from the agent dashboard link.
ELEVENLABS_BRANCH_ID=
SQLITE_PATH=data/capture.sqlite

# Optional Gemini Sandbox account and trusted telephony backend
GEMINI_API_KEY=
GEMINI_API_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOOL_SHARED_SECRET=
PUBLIC_PHONE_NUMBER=
# Hosted call confirmation secret shared only with the ElevenLabs webhook.
ELEVENLABS_CALL_CONFIRM_SECRET=
EXECUTION_ENABLED=false

# Optional Solana devnet receipt signer (JSON keypair) and RPC
SOLANA_RECEIPT_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
