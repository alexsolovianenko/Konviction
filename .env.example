# All settings are server-side. Public market data needs none of these.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional branchId from the agent dashboard link.
ELEVENLABS_BRANCH_ID=
SQLITE_PATH=data/capture.sqlite

# Optional Gemini Sandbox account and trusted telephony backend
GEMINI_API_KEY=
GEMINI_API_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOOL_SHARED_SECRET=
PUBLIC_PHONE_NUMBER=
# Hosted call confirmation secret shared only with the ElevenLabs webhook.
ELEVENLABS_CALL_CONFIRM_SECRET=
EXECUTION_ENABLED=false

# Optional Solana devnet receipt signer (JSON keypair) and RPC
SOLANA_RECEIPT_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional QuickNode x402 crypto research (docs/quicknode-research.md). Server-only; never prefix with VITE_.
# Payments stay off unless exactly "true", and also require Vercel Blob (BLOB_READ_WRITE_TOKEN).
QUICKNODE_RESEARCH_PAYMENTS=false
# Dedicated Arc Testnet research wallet. Set the key ONLY in the Vercel dashboard (Sensitive), never in git or chat.
RESEARCH_WALLET_PRIVATE_KEY=
# Public address the key must derive to; approval refuses on mismatch.
QUICKNODE_RESEARCH_WALLET_ADDRESS=
# Shared durable payment ledger (Vercel Blob, private store).
BLOB_READ_WRITE_TOKEN=
# Optional caps in atomic USDC (6 decimals). Can only LOWER the hard caps 10000 / 100000 / 250000.
QUICKNODE_RESEARCH_MAX_PER_REQUEST_ATOMIC=
QUICKNODE_RESEARCH_MAX_PER_SESSION_ATOMIC=
QUICKNODE_RESEARCH_MAX_PER_DAY_ATOMIC=
# Optional comma-separated overrides if QuickNode rotates its payee or Gateway contract.
QUICKNODE_X402_PAYTO=
QUICKNODE_X402_GATEWAY_VERIFIERS=

# Native phone calls. Provisioning credentials are needed only when importing the line.
TWILIO_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_PHONE_BRANCH_ID=
# Inbound public phone demo. Set the selector to website-demo to share the website sandbox.
PHONE_SANDBOX_ACCOUNT=phone-demo
PHONE_DEMO_GEMINI_API_KEY=
PHONE_DEMO_GEMINI_API_SECRET=
# Optional outbound settlement subscribers only
PHONE_ACCOUNTS_JSON=[]
CRON_SECRET=
