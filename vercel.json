{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "buildCommand": "npm run build:vercel",
  "crons": [
    {
      "path": "/api/public/phone/settlements",
      "schedule": "0 16 * * *"
    }
  ],
  "functions": {
    "api/settlement-watch.mjs": {
      "maxDuration": 120,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "konviction-settlements",
          "retryAfterSeconds": 3
        }
      ]
    }
  }
}
